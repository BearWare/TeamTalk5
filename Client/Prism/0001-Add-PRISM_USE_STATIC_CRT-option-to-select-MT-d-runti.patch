From ab806c33af77bc91e14f58bdb7332ad2d1fa0294 Mon Sep 17 00:00:00 2001
From: Sihu Hwang <129564966+hwangsihu@users.noreply.github.com>
Date: Thu, 29 Oct 2026 20:37:29 +0900
Subject: [PATCH] Add PRISM_USE_STATIC_CRT option to select /MT(d) runtime

---
 cmake/PrismOptions.cmake | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/cmake/PrismOptions.cmake b/cmake/PrismOptions.cmake
index a7bf8e8..36de51a 100644
--- a/cmake/PrismOptions.cmake
+++ b/cmake/PrismOptions.cmake
@@ -21,6 +21,7 @@ option(PRISM_ENABLE_LEGACY_BACKENDS
        "Build backends for discontinued screen readers" OFF)
 option(PRISM_ENABLE_POWER_MANAGEMENT
        "Enable OS power-state-aware availability polling where supported" ON)
+option(PRISM_USE_STATIC_CRT "Use /MT(d) static CRT on MSVC" OFF)
 option(PRISM_ENABLE_LINTING
        "Run available linters as part of the build (implies warnings as errors)"
        OFF)
@@ -75,7 +76,7 @@ if(WIN32 AND NOT _prism_xbox_requested)
     set(CMAKE_MSVC_RUNTIME_LIBRARY
         "MultiThreadedDLL"
         CACHE STRING "Match godot-cpp non-debug CRT")
-  else()
+  elseif(PRISM_USE_STATIC_CRT)
     set(CMAKE_MSVC_RUNTIME_LIBRARY
         "MultiThreaded$<$<CONFIG:Debug>:Debug>"
         CACHE STRING "MSVC CRT library type")
-- 
2.56.0.windows.4

