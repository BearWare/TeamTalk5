cd ACE
set ACE_ROOT=%CD%
set SSL_ROOT=@OPENSSL_DIR@
rem Force synchronous PDB writes: ACE's MPC-generated project shares one
rem PDB per target, which otherwise races under parallel (-maxCpuCount)
rem compilation (MSVC C1041).
set CL=/FS
perl %ACE_ROOT%\bin\mwc.pl -type vs2022 -static -features ssl=1 -features uses_wchar=1 -features ipv6=1 -expand_vars ace protocols
